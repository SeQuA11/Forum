<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.forum.forumd.controller.ForumController"
            stylesheets="@styles.css">

    <!-- Верхняя панель -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
            </padding>

            <Label text="Форум с модерацией" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" styleClass="welcome-label"/>
            <Label fx:id="roleLabel" styleClass="role-label"/>
            <Button text="Выйти" onAction="#onLogoutClick" styleClass="logout-button"/>
        </HBox>
    </top>

    <!-- Левая панель с категориями -->
    <left>
        <VBox spacing="10.0" styleClass="sidebar" prefWidth="300.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>

            <Label text="Все категории" styleClass="section-label"/>
            <Button text="Показать все темы" onAction="#onAllCategoriesClick" styleClass="primary-button" maxWidth="Infinity"/>
            <ListView fx:id="categoryListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- Центральная область с темами -->
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Темы форума" styleClass="section-label"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔄 Обновить" onAction="#onRefreshClick" styleClass="refresh-button"/>
                <Button text="➕ Создать тему" onAction="#onCreateThreadClick" styleClass="primary-button"/>
            </HBox>

            <!-- Таблица тем -->
            <TableView fx:id="threadsTableView" VBox.vgrow="ALWAYS" onMouseClicked="#onThreadDoubleClick">
                <columns>
                    <!-- Фиксированные узкие колонки -->
                    <TableColumn fx:id="pinColumn" text="" prefWidth="40.0" maxWidth="40.0" minWidth="40.0" resizable="false" sortable="false"/>
                    <!-- Название занимает всё оставшееся место -->
                    <TableColumn fx:id="titleColumn" text="Название" prefWidth="-1.0"/>
                    <TableColumn fx:id="authorColumn" text="Автор" prefWidth="120.0" maxWidth="120.0" minWidth="120.0" resizable="false" sortable="false"/>
                    <TableColumn fx:id="statusColumn" text="Статус" prefWidth="110.0" maxWidth="110.0" minWidth="110.0" resizable="false" sortable="false"/>
                    <TableColumn fx:id="viewsColumn" text="👁" prefWidth="60.0" maxWidth="60.0" minWidth="60.0" resizable="false" sortable="false"/>
                    <TableColumn fx:id="actionsColumn" text="Действия" prefWidth="130.0" maxWidth="130.0" minWidth="130.0" resizable="false" sortable="false"/>
                </columns>
            </TableView>

            <!-- Панель создания новой темы -->
            <VBox fx:id="createThreadPane" spacing="10.0" visible="false" managed="false" styleClass="create-thread-pane">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Создание новой темы" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✕" onAction="#onCloseCreateThreadPane" styleClass="close-button" maxWidth="30"/>
                </HBox>

                <TextField fx:id="newThreadTitleArea" promptText="Заголовок темы" styleClass="input-field"/>
                <TextArea fx:id="newThreadContentArea" promptText="Содержание темы" prefHeight="150.0" styleClass="input-area"/>
                <HBox spacing="10.0">
                    <ComboBox fx:id="categoryComboBox" promptText="Выберите категорию" HBox.hgrow="ALWAYS" styleClass="combo-box"/>
                    <Button text="Опубликовать" onAction="#onSubmitNewThreadClick" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Нижняя панель со статусом -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar">
            <padding>
                <Insets bottom="5.0" left="20.0" right="20.0" top="5.0"/>
            </padding>
            <Label fx:id="statusLabel" text="Готов к работе" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="threadCountLabel" text="Тем: 0" styleClass="info-label"/>
        </HBox>
    </bottom>
</BorderPane>